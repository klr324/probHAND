BootStrap: docker
From: ubuntu:22.04

%environment
    # Set up slurm execution and dependency paths
    LD_LIBRARY_PATH=/usr/lib64:$LD_LIBRARY_PATH
    PATH=$PATH:/storage/sys/slurm/bin

    # Expose GDAL header paths for any runtime python package compilations
    export CPLUS_INCLUDE_PATH=/usr/include/gdal
    export C_INCLUDE_PATH=/usr/include/gdal

    # Expose the TauDEM installation globally
    export PATH="/usr/local/taudem:${PATH}"

    # Maintain custom prompt styling
    SINGULARITYENV_PS1='\n\[\033[01;33m\][`basename ${SINGULARITY_CONTAINER} .simg`]\[\033[00m\] \[\033[01;34m\]\w\[\033[00m\] \$ '

%runscript
    exec /bin/bash "$@"

%post
    # Prevent interactive prompts during build phase
    DEBIAN_FRONTEND=noninteractive

    # Fix package sources to Ubuntu 22.04 (Jammy)
    echo "deb http://us.archive.ubuntu.com/ubuntu/ jammy main restricted universe multiverse" > /etc/apt/sources.list
    echo "deb http://us.archive.ubuntu.com/ubuntu/ jammy-updates main restricted universe multiverse" >> /etc/apt/sources.list
    echo "deb http://us.archive.ubuntu.com/ubuntu/ jammy-security main restricted universe multiverse" >> /etc/apt/sources.list
    echo "deb http://us.archive.ubuntu.com/ubuntu/ jammy-backports main restricted universe multiverse" >> /etc/apt/sources.list

    # Base package initialization
    apt-get -q update
    apt-get install -y tzdata
    apt-get -qy dist-upgrade
    apt-get -y install software-properties-common dirmngr wget less git
    #apt-get -qy dist-upgrade

    # Add PPAs for Python 3.11 and upgraded GDAL binaries (v3.6+)
    add-apt-repository ppa:deadsnakes/ppa -y
    add-apt-repository ppa:ubuntugis/ubuntugis-unstable -y
    apt-get -q update

    # Install development dependencies, TauDEM dependencies, System libraries, and Build 
    apt-get -y install --no-install-recommends build-essential cmake openmpi-bin libopenmpi-dev mpi-default-dev libproj-dev proj-bin libnetcdf-dev libudunits2-dev libprotobuf-dev libv8-dev libjq-dev protobuf-compiler libfontconfig1-dev libharfbuzz-dev libfribidi-dev libtiff-dev libgeotiff-dev gdal-bin gdal-data libgdal-dev

    # Install Python 3.11 and development environments
    apt-get install -y python3.11 python3.11-dev python3.11-venv python3.11-distutils libcurl4-gnutls-dev libgnutls28-dev

    # Configure default python3 alternative and bootstrap get-pip
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
    python3.11 -m ensurepip --upgrade

    # Configure System Locales
    apt-get install -y locales
    sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    dpkg-reconfigure --frontend=noninteractive locales
    update-locale LANG=en_US.UTF-8

    # Set up compilation environmental variables for Python wheels
    export CPLUS_INCLUDE_PATH=/usr/include/gdal
    export C_INCLUDE_PATH=/usr/include/gdal

    # Install specific versions of Python packages targeting Python 3.11 explicitely
    python3.11 -m pip install --upgrade pip setuptools wheel
    python3.11 -m pip install "numpy>=1.24,<2.0"
    python3.11 -m pip install "pandas>=1.5,<2.0"
    python3.11 -m pip install "scipy>=1.10,<2.0"
    python3.11 -m pip install "matplotlib>=3.7,<4.0"

    # FORCE PIP TO COMPILE GDAL we need "GDAL>=3.6,<3.8"
    python3.11 -m pip install --no-cache-dir --force-reinstall --no-build-isolation "GDAL==$(gdal-config --version)"
    python3.11 -m pip install "geopandas>=0.12,<1.0"
    python3.11 -m pip install "shapely>=2.0,<3.0" 

    # Clone and compile TauDEM using the official workflow
    git clone https://github.com/dtarb/TauDEM.git /opt/TauDEM
    cd /opt/TauDEM

    # Build and install the TauDEM binaries (This naturally aligns compilers on your x86_64 system)
    # By default, this places them in /usr/local/taudem
    make release COMPILER=linux
    make install

    # Clean up orphaned libraries and artifacts to minimize final image size
    cd /
    apt-get -y autoremove
    apt-get -y clean
    rm -rf /var/lib/apt/lists/*
